{
  "$defs": {
    "ActionUtilityEstimate": {
      "properties": {
        "action": {
          "$ref": "#/$defs/DSLOperationName"
        },
        "expected_info_gain": {
          "default": 0.0,
          "title": "Expected Info Gain",
          "type": "number"
        },
        "expected_falsification_gain": {
          "default": 0.0,
          "title": "Expected Falsification Gain",
          "type": "number"
        },
        "expected_decision_gain": {
          "default": 0.0,
          "title": "Expected Decision Gain",
          "type": "number"
        },
        "cost": {
          "default": 1.0,
          "title": "Cost",
          "type": "number"
        },
        "latency_ms": {
          "default": 10.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "risk_penalty": {
          "default": 0.0,
          "title": "Risk Penalty",
          "type": "number"
        },
        "net_utility": {
          "default": 0.0,
          "title": "Net Utility",
          "type": "number"
        },
        "voi": {
          "default": 0.0,
          "title": "Voi",
          "type": "number"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "reasoning": {
          "default": "",
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "ActionUtilityEstimate",
      "type": "object"
    },
    "AgentResult": {
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentStatus",
          "default": "completed"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence_score": {
          "description": "Uncalibrated operational score; not a probability.",
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Score",
          "type": "number"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "findings": {
          "additionalProperties": true,
          "title": "Findings",
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "agent_id",
        "summary",
        "evidence_score",
        "latency_ms"
      ],
      "title": "AgentResult",
      "type": "object"
    },
    "AgentStatus": {
      "enum": [
        "completed",
        "skipped",
        "failed"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "CounterfactualStatement": {
      "properties": {
        "target_decision": {
          "$ref": "#/$defs/InvestigationDecision"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "minimal_evidence_delta": {
          "title": "Minimal Evidence Delta",
          "type": "string"
        },
        "hypothetical_reason_code": {
          "$ref": "#/$defs/DecisionReasonCode"
        }
      },
      "required": [
        "target_decision",
        "condition",
        "minimal_evidence_delta",
        "hypothetical_reason_code"
      ],
      "title": "CounterfactualStatement",
      "type": "object"
    },
    "DSLOperation": {
      "properties": {
        "op_name": {
          "$ref": "#/$defs/DSLOperationName"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "target_hypotheses": {
          "items": {
            "type": "string"
          },
          "title": "Target Hypotheses",
          "type": "array"
        },
        "cost_units": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Cost Units",
          "type": "number"
        },
        "expected_info_value": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Info Value",
          "type": "number"
        },
        "expected_falsification_gain": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Falsification Gain",
          "type": "number"
        },
        "expected_decision_gain": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Decision Gain",
          "type": "number"
        },
        "reasoning": {
          "default": "",
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "op_name"
      ],
      "title": "DSLOperation",
      "type": "object"
    },
    "DSLOperationName": {
      "enum": [
        "RUN_CUSUM",
        "RUN_PAGE_HINKLEY",
        "RUN_PELT",
        "RUN_BOCPD",
        "COMPARE_WINDOWS",
        "CALCULATE_ENTROPY",
        "CHECK_SUSCEPTIBILITY",
        "TEST_TEMPORAL_STACKING",
        "REQUEST_FEATURE",
        "EVALUATE_HYPOTHESIS",
        "RECOMMEND_DECISION",
        "ASK_HUMAN"
      ],
      "title": "DSLOperationName",
      "type": "string"
    },
    "DSLResult": {
      "properties": {
        "op_name": {
          "$ref": "#/$defs/DSLOperationName"
        },
        "status": {
          "default": "success",
          "title": "Status",
          "type": "string"
        },
        "observed_value": {
          "default": null,
          "title": "Observed Value"
        },
        "evidence_generated": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence Generated",
          "type": "array"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        },
        "contradicts": {
          "items": {
            "type": "string"
          },
          "title": "Contradicts",
          "type": "array"
        },
        "cost_units": {
          "default": 1.0,
          "title": "Cost Units",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "op_name"
      ],
      "title": "DSLResult",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "pass",
        "human_review",
        "insufficient_evidence",
        "blocked"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionOutcome": {
      "properties": {
        "decision": {
          "$ref": "#/$defs/InvestigationDecision"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/DecisionReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "primary_reason": {
          "title": "Primary Reason",
          "type": "string"
        },
        "stop_reason": {
          "$ref": "#/$defs/StopReason",
          "default": "DECISION_SUFFICIENT"
        },
        "human_review_required": {
          "default": false,
          "title": "Human Review Required",
          "type": "boolean"
        },
        "prohibited_actions": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Actions",
          "type": "array"
        },
        "accepted_hypothesis_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Hypothesis Id"
        },
        "residual_uncertainty": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Residual Uncertainty",
          "type": "number"
        },
        "decision_confidence": {
          "default": 0.85,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Decision Confidence",
          "type": "number"
        },
        "selective_decision_approved": {
          "default": true,
          "title": "Selective Decision Approved",
          "type": "boolean"
        }
      },
      "required": [
        "decision",
        "primary_reason"
      ],
      "title": "DecisionOutcome",
      "type": "object"
    },
    "DecisionProvenanceEdge": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "relation"
      ],
      "title": "DecisionProvenanceEdge",
      "type": "object"
    },
    "DecisionProvenanceGraphData": {
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/DecisionProvenanceNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DecisionProvenanceEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "mermaid_diagram": {
          "default": "",
          "title": "Mermaid Diagram",
          "type": "string"
        }
      },
      "title": "DecisionProvenanceGraphData",
      "type": "object"
    },
    "DecisionProvenanceNode": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "timestamp"
      ],
      "title": "DecisionProvenanceNode",
      "type": "object"
    },
    "DecisionReasonCode": {
      "enum": [
        "TRANSIENT_NOISE_CONFIRMED",
        "REGIME_SHIFT_CONFIRMED",
        "STRUCTURAL_BREAK_SUPPORTED",
        "COORDINATED_WEAK_SIGNAL_DETECTED",
        "ALTERNATIVE_NOT_FALSIFIED",
        "MATERIAL_UNCERTAINTY",
        "BUDGET_EXHAUSTED",
        "GOVERNANCE_POLICY_REQUIRED",
        "BENIGN_FLUCTUATION_SURVIVED",
        "TEST_FAILURE_DEGRADATION",
        "UNAUTHORIZED_ACTION_BLOCKED",
        "UNKNOWN_REGIME_DOMINANT",
        "VOI_EXHAUSTION"
      ],
      "title": "DecisionReasonCode",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        }
      },
      "required": [
        "code",
        "statement"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceItem": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "hypotheses_discriminated": {
          "items": {
            "type": "string"
          },
          "title": "Hypotheses Discriminated",
          "type": "array"
        },
        "why_selected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Selected"
        },
        "expected_information_value": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Information Value",
          "type": "number"
        },
        "expected_falsification_gain": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Falsification Gain",
          "type": "number"
        },
        "expected_decision_relevance": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Decision Relevance",
          "type": "number"
        },
        "cost_units": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Cost Units",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "provenance_source": {
          "default": "deterministic_dsl_sandbox",
          "title": "Provenance Source",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "code",
        "statement"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "GovernanceResult": {
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "human_review_required": {
          "default": true,
          "title": "Human Review Required",
          "type": "boolean"
        },
        "prohibited_actions": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Actions",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "GovernanceResult",
      "type": "object"
    },
    "Hypothesis": {
      "properties": {
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence_score": {
          "description": "Uncalibrated evidence ranking score.",
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Score",
          "type": "number"
        },
        "supporting_agents": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Agents",
          "type": "array"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "falsification_status": {
          "default": "pending",
          "title": "Falsification Status",
          "type": "string"
        },
        "counterevidence": {
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "claim",
        "evidence_score"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "HypothesisStatus": {
      "enum": [
        "active",
        "leading",
        "challenged",
        "falsified",
        "confirmed",
        "inconclusive"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    },
    "IntegrityChainRecord": {
      "properties": {
        "step_index": {
          "title": "Step Index",
          "type": "integer"
        },
        "event_hash": {
          "title": "Event Hash",
          "type": "string"
        },
        "previous_hash": {
          "title": "Previous Hash",
          "type": "string"
        },
        "payload_summary": {
          "title": "Payload Summary",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "step_index",
        "event_hash",
        "previous_hash",
        "payload_summary",
        "timestamp"
      ],
      "title": "IntegrityChainRecord",
      "type": "object"
    },
    "InvestigationBudget": {
      "properties": {
        "max_steps": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tests": {
          "default": 6,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Tests",
          "type": "integer"
        },
        "max_cost_units": {
          "default": 10.0,
          "minimum": 1.0,
          "title": "Max Cost Units",
          "type": "number"
        },
        "max_runtime_ms": {
          "default": 5000.0,
          "minimum": 100.0,
          "title": "Max Runtime Ms",
          "type": "number"
        },
        "steps_used": {
          "default": 0,
          "title": "Steps Used",
          "type": "integer"
        },
        "tests_used": {
          "default": 0,
          "title": "Tests Used",
          "type": "integer"
        },
        "cost_units_used": {
          "default": 0.0,
          "title": "Cost Units Used",
          "type": "number"
        },
        "runtime_ms_used": {
          "default": 0.0,
          "title": "Runtime Ms Used",
          "type": "number"
        }
      },
      "title": "InvestigationBudget",
      "type": "object"
    },
    "InvestigationDecision": {
      "enum": [
        "CLOSE",
        "WATCH",
        "ESCALATE",
        "DEFER",
        "REQUEST_HUMAN_REVIEW"
      ],
      "title": "InvestigationDecision",
      "type": "string"
    },
    "InvestigationHypothesis": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "claim": {
          "default": "",
          "title": "Claim",
          "type": "string"
        },
        "prior_evidence_score": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Prior Evidence Score",
          "type": "number"
        },
        "evidence_score": {
          "default": 0.5,
          "description": "Uncalibrated heuristic evidence score (not a probability).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Score",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus",
          "default": "active"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "contradicting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting Evidence",
          "type": "array"
        },
        "falsification_attempts": {
          "default": 0,
          "title": "Falsification Attempts",
          "type": "integer"
        },
        "falsification_outcomes": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Falsification Outcomes",
          "type": "array"
        },
        "tests_executed": {
          "items": {
            "type": "string"
          },
          "title": "Tests Executed",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "InvestigationHypothesis",
      "type": "object"
    },
    "InvestigationState": {
      "enum": [
        "OBSERVING",
        "SIGNAL_DETECTED",
        "TRIAGING",
        "INVESTIGATING",
        "EVIDENCE_INSUFFICIENT",
        "DECISION_READY",
        "CLOSED",
        "WATCHING",
        "ESCALATED",
        "DEFERRED",
        "HUMAN_REVIEW_REQUIRED"
      ],
      "title": "InvestigationState",
      "type": "string"
    },
    "MultimodalEvidenceClaim": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "extracted_statement": {
          "title": "Extracted Statement",
          "type": "string"
        },
        "claimed_timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Timestamp"
        },
        "claimed_feature": {
          "default": "regime_change",
          "title": "Claimed Feature",
          "type": "string"
        },
        "verification_status": {
          "default": "unverified",
          "title": "Verification Status",
          "type": "string"
        },
        "cross_check_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Check Evidence Id"
        }
      },
      "required": [
        "source_file",
        "source_hash",
        "extracted_statement"
      ],
      "title": "MultimodalEvidenceClaim",
      "type": "object"
    },
    "StateTransitionRecord": {
      "properties": {
        "from_state": {
          "$ref": "#/$defs/InvestigationState"
